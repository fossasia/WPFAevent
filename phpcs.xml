<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="WPFA Event">
  <description>WordPress Coding Standards for WPFA Event plugin.</description>

  <!-- Include WordPress Coding Standards -->
  <rule ref="WordPress"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-Core"/>
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="delete_events"/>
        <element value="delete_speakers"/>
        <element value="edit_events"/>
        <element value="edit_speakers"/>
        <element value="publish_events"/>
        <element value="publish_speakers"/>
      </property>
    </properties>
  </rule>

  <!-- Squiz.WhiteSpace.SuperfluousWhitespace never registers T_INLINE_HTML,
       so trailing whitespace inside template markup needs its own sniff. -->
  <rule ref="./phpcs/WPFAEvent/Sniffs/WhiteSpace/InlineHtmlTrailingWhitespaceSniff.php"/>

  <!-- WordPress-specific config -->
  <config name="minimum_supported_wp_version" value="5.0"/>

  <!-- Arguments for PHPCS -->
  <arg value="sp"/>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg name="parallel" value="8"/>

  <!-- What to scan -->
  <file>.</file>

  <!-- Exclude patterns -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/tmp/*</exclude-pattern>
  <exclude-pattern>*/bin/*</exclude-pattern>
  <!-- Custom sniffs follow PHP_CodeSniffer's own file and class conventions. -->
  <exclude-pattern>/phpcs/*</exclude-pattern>
</ruleset>
